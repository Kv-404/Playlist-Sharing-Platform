PORT=4000
# Local MongoDB. For deployment, use an Atlas string whose path is /playlist-platform.
# A string with no database name stores users in a database called test.
MONGO_URI=mongodb://127.0.0.1:27017/playlist-platform
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Origin of the React app. Required so the browser can call this API.
CLIENT_URL=http://localhost:5173
