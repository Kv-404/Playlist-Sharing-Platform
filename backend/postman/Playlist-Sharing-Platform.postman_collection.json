{
  "info": {
    "name": "Playlist Sharing Platform",
    "description": "Case study 162. Run the folder from top to bottom. Register creates two users, login saves tokens, and later requests reuse playlistId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "token", "value": "" },
    { "key": "otherToken", "value": "" },
    { "key": "playlistId", "value": "" },
    { "key": "commentId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register owner",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Owner\",\n  \"email\": \"ada@example.com\",\n  \"password\": \"secret12\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('owner login succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body.success).to.eql(true);",
                  "});",
                  "pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@example.com\",\n  \"password\": \"secret12\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Register listener",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Grace Listener\",\n  \"email\": \"grace@example.com\",\n  \"password\": \"secret12\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login listener",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('listener login succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.set('otherToken', body.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"grace@example.com\",\n  \"password\": \"secret12\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Playlists",
      "item": [
        {
          "name": "Create playlist",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('playlist created', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(body.data.songs.length).to.eql(2);",
                  "});",
                  "pm.collectionVariables.set('playlistId', body.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Late night\",\n  \"description\": \"Quiet songs for a long drive\",\n  \"songs\": [\"Nightride\", \"Holocene\"]\n}"
            },
            "url": "{{baseUrl}}/api/playlists"
          }
        },
        {
          "name": "Reject empty playlist",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('empty songs rejected', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Empty\",\n  \"songs\": []\n}"
            },
            "url": "{{baseUrl}}/api/playlists"
          }
        },
        {
          "name": "List playlists",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/playlists"
          }
        },
        {
          "name": "Get playlist",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/playlists/{{playlistId}}"
          }
        },
        {
          "name": "Like playlist",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('like toggled on', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body.data.liked).to.eql(true);",
                  "  pm.expect(body.data.likeCount).to.eql(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{otherToken}}" }],
            "url": "{{baseUrl}}/api/playlists/{{playlistId}}/like"
          }
        },
        {
          "name": "Unlike playlist",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('like toggled off', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body.data.liked).to.eql(false);",
                  "  pm.expect(body.data.likeCount).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{otherToken}}" }],
            "url": "{{baseUrl}}/api/playlists/{{playlistId}}/like"
          }
        },
        {
          "name": "Comment on playlist",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('comment created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set('commentId', body.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{otherToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"This one stays on repeat.\"\n}"
            },
            "url": "{{baseUrl}}/api/playlists/{{playlistId}}/comments"
          }
        },
        {
          "name": "Owner updates playlist",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('owner can edit', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.title).to.eql('Late night drive');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Late night drive\"\n}"
            },
            "url": "{{baseUrl}}/api/playlists/{{playlistId}}"
          }
        },
        {
          "name": "Listener cannot update playlist",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('non-owner is forbidden', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{otherToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hijacked\"\n}"
            },
            "url": "{{baseUrl}}/api/playlists/{{playlistId}}"
          }
        },
        {
          "name": "Listener cannot delete comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('only the author can delete a comment', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/comments/{{commentId}}"
          }
        },
        {
          "name": "Author deletes comment",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{otherToken}}" }],
            "url": "{{baseUrl}}/api/comments/{{commentId}}"
          }
        },
        {
          "name": "Listener cannot delete playlist",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('non-owner cannot delete', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{otherToken}}" }],
            "url": "{{baseUrl}}/api/playlists/{{playlistId}}"
          }
        },
        {
          "name": "Owner deletes playlist",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/playlists/{{playlistId}}"
          }
        }
      ]
    }
  ]
}
